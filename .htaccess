# Trireka Presisi (Apache / LiteSpeed, mis. cPanel, Hostinger, Niagahoster)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Folder inti & data tidak boleh dibuka dari browser
  RewriteRule ^(inc|data)(/|$) - [F,L]
  RewriteRule (^|/)\.git - [F,L]
</IfModule>

<FilesMatch "\.(md|lock|json|bin)$">
  Require all denied
</FilesMatch>

# Batas upload formulir penawaran (berlaku bila hosting mengizinkan)
<IfModule mod_php.c>
  php_value upload_max_filesize 25M
  php_value post_max_size 30M
</IfModule>
